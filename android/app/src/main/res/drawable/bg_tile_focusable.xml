<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado com foco (navegação por controle remoto/D-pad), precisa
    ser bem visível, já que em TV Box não tem cursor/toque pra saber onde
    está "parado" na tela, só esse destaque. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#333DDC97" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#223DDC97" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</selector>
