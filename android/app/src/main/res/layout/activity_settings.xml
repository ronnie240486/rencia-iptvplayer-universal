<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.meuapp.iptvplayer.ui.common.BackdropView
        android:id="@+id/backdropView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/toolbar_content" android:id="@+id/toolbar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <include android:id="@+id/rowAccount" layout="@layout/setting_row" />
                <include android:id="@+id/rowRefreshContent" layout="@layout/setting_row" />
                <include android:id="@+id/rowSwitchPlaylist" layout="@layout/setting_row" />
                <include android:id="@+id/rowDevice" layout="@layout/setting_row" />
                <include android:id="@+id/rowSupport" layout="@layout/setting_row" />
                <include android:id="@+id/rowCache" layout="@layout/setting_row" />
                <include android:id="@+id/rowLanguage" layout="@layout/setting_row" />
                <include android:id="@+id/rowParental" layout="@layout/setting_row" />
                <include android:id="@+id/rowPlayer" layout="@layout/setting_row" />
                <include android:id="@+id/rowDiagnostics" layout="@layout/setting_row" />
                <include android:id="@+id/rowVersion" layout="@layout/setting_row" />
                <include android:id="@+id/rowLogout" layout="@layout/setting_row" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tile"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Barra de categorias"
                                android:textColor="@color/white"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Personalizar a cor da navegação"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchCategoryBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerColors"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/border" />

                    <TextView
                        android:id="@+id/tvChooseColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="Escolha a cor"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10.5sp" />

                    <GridLayout
                        android:id="@+id/gridColors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:rowCount="2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tile"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fundo com pôster"
                            android:textColor="@color/white"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Usar imagem de conteúdo no fundo"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchBackdrop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
