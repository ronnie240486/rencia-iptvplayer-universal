<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/homeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/home_dashboard" />

    <FrameLayout
        android:id="@+id/dashboardOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btnLiveTv"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Live TV"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnEpg"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="EPG"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnVod"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="VOD"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnSeries"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Séries"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnAccount"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Conta"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnMulti"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Multi"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnCatchUp"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Catch Up"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Favoritos"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnRadio"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Rádio"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Configurações"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes" />
    </FrameLayout>
</FrameLayout>
